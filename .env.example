# docker-compose.deploy.yml에서 호스트에 게시할 ai-pt Nginx 포트다.
AI_PT_PUBLIC_PORT=18443

# 운영 PostgreSQL 설정이다. 비밀번호는 URL에 사용할 수 있는 안전한 문자로 설정한다.
AI_PT_POSTGRES_DB=at_pt
AI_PT_POSTGRES_USER=a2t
AI_PT_POSTGRES_PASSWORD=replace-with-strong-postgres-password

# 운영 MinIO 관리자 계정이다. 클라이언트 env나 앱 번들에는 넣지 않는다.
AI_PT_MINIO_ROOT_USER=replace-with-minio-admin
AI_PT_MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
AI_PT_MINIO_PUBLIC_BUCKET=pt-diary-assets

# 아래 값은 로컬 개발용 docker-compose.yml에서만 사용한다.
MINIO_ROOT_USER=replace-with-minio-admin
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
MINIO_PUBLIC_BUCKET=pt-diary-assets
