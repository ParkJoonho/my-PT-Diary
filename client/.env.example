# 앱 런타임이 호출하는 백엔드 공개 주소다.
# 실기기에서는 개발 PC의 LAN IP, 배포 환경에서는 HTTPS API 주소로 바꾼다.
API_BASE_URL=http://YOUR_MAC_LAN_IP:3000

# 앱 런타임이 공개 정적 에셋을 직접 조회하는 주소다.
# MinIO 콘솔 주소(9001)나 관리자 자격증명을 넣지 않는다.
# 배포 환경에서는 MinIO 또는 CDN의 HTTPS 공개 주소를 사용한다.
ASSET_BASE_URL=http://YOUR_MAC_LAN_IP:9000/pt-diary-assets/v1

# Orval 코드 생성 시에만 사용하는 백엔드 OpenAPI 문서 주소다.
# 앱이 MinIO 파일을 조회할 때는 사용하지 않는다.
OPENAPI_SCHEMA_URL=http://127.0.0.1:3000/docs-json
